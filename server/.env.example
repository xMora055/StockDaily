# Puerto del servidor Express
PORT=3000

# Cadena de conexión a PostgreSQL (Supabase, Session pooler)
DATABASE_URL=postgresql://usuario:password@host:5432/basedatos

# URL del frontend permitida por CORS
CLIENT_URL=http://localhost:5173

# Autenticación JWT (usar una clave larga y aleatoria)
JWT_SECRETO=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRACION=8h
